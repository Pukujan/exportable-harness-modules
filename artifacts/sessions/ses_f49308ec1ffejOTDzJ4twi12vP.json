int:\n56:     p = argparse.ArgumentParser(description=__doc__)\n57:     p.add_argument(\"--memories\", type=Path, help=\"Path to hades-v2-memories clone\")\n58:     p.add_argument(\n59:         \"--conversations\",\n60:         type=Path,\n61:         help=\"Path to conversations/ (overrides --memories)\",\n62:     )\n63:     p.add_argument(\"--out\", type=Path, default=Path(\"docs/transcripts-stats.md\"))\n64:     p.add_argument(\"--out-stats\", type=Path, help=\"Alias for --out\")\n65:     p.add_argument(\"--out-schema\", type=Path, default=Path(\"docs/transcripts-schema.md\"))\n66:     p.add_argument(\"--max-message-files\", type=int, default=0, help=\"0 = all shards\")\n67:     args = p.parse_args()\n68: \n69:     out_stats = args.out_stats or args.out\n70:     conv = resolve_conversations(args.memories, args.conversations)\n71:     sessions_path = conv / \"sessions.jsonl\"\n72:     if not sessions_path.is_file():\n73:         print(f\"missing {sessions_path}\", file=sys.stderr)\n74:         return 1\n75: \n76:     sources = collections.Counter()\n77:     models = collections.Counter()\n78:     end_reasons = collections.Counter()\n79:     chat_types = collections.Counter()\n80:     user_id_set = collections.Counter()\n81:     msg_counts: list[int] = []\n82:     tool_counts: list[int] = []\n83:     starts: list[float] = []\n84:     ends: list[float] = []\n85:     session_keys: set[str] = set()\n86:     session_field_keys: set[str] = set()\n87:     n_sessions = 0\n88:     n_session_bad = 0\n89:     titles_nonempty = 0\n90: \n91:     for row in iter_jsonl(sessions_path):\n92:         if row.get(\"__bad__\"):\n93:             n_session_bad += 1\n94:             continue\n95:         n_sessions += 1\n96:         session_field_keys.update(row.keys())\n97:         sid = row.get(\"id\")\n98:         if sid:\n99:             session_keys.add(str(sid))\n100:         sources[str(row.get(\"source\") or \"null\")] += 1\n101:         models[str(row.get(\"model\") or \"null\")